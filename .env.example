# Variables de entorno del Foro de Ciberseguridad 2026
# Copia este archivo a .env y completa los valores. NO incluyas secretos reales aquí ni lo subas con valores.

# Clave de acceso al panel administrativo completo (/admin y APIs de administración).
ADMIN_KEY=

# Clave que autoriza UNICAMENTE el endpoint /api/checkin (control de acceso/escaner).
# Debe ser DIFERENTE de ADMIN_KEY. Se envia en el encabezado x-scanner-key.
# No otorga acceso al panel ni a ninguna otra API.
SCANNER_KEY=

# Secreto aleatorio de alta entropia para firmar los boletos (HMAC).
TICKET_SECRET=

# Llave privada de la cuenta de Resend (envio de correos).
RESEND_API_KEY=

# Remitente verificado, por ejemplo: Foro ACLUVAQ <foro@dominio.org>
EMAIL_FROM=
